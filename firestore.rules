rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && (request.auth.token.admin == true || exists(/databases/$(database)/documents/admins/$(request.auth.uid))); }
    function isSelf(userId) { return signedIn() && request.auth.uid == userId; }
    function groupMember(groupId) { return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)); }
    function validCoordinates(data) { return data.latitude is number && data.longitude is number && data.latitude >= -90 && data.latitude <= 90 && data.longitude >= -180 && data.longitude <= 180 && data.location is latlng; }
    function validPandal(data) { return data.keys().hasAll(['name', 'address', 'locality', 'location', 'latitude', 'longitude', 'status', 'createdBy', 'createdAt', 'updatedAt']) && data.name is string && data.name.size() > 0 && data.name.size() <= 160 && data.address is string && data.locality is string && data.status in ['draft', 'published', 'archived'] && data.createdBy is string && data.createdAt is timestamp && data.updatedAt is timestamp && validCoordinates(data); }

    match /pandals/{pandalId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin() && request.resource.data.createdBy == request.auth.uid && validPandal(request.resource.data);
      allow update: if isAdmin() && request.resource.data.createdBy == resource.data.createdBy && validPandal(request.resource.data);
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if signedIn();
      allow create: if isSelf(adminId) && request.resource.data.passcode == "PUJA26_SECRET_ADMIN_2026";
      allow update, delete: if isAdmin();
    }

    match /locations/{locationId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /favourites/{favouriteId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /visits/{visitId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if signedIn() && (resource == null ? request.resource.data.userId : resource.data.userId) == request.auth.uid;
    }

    match /itineraries/{itineraryId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if signedIn() && (resource == null ? request.resource.data.userId : resource.data.userId) == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /groups/{groupId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if signedIn();
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{userId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn() && (request.auth.uid == userId || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid);
      }

      match /stops/{stopId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn();
      }
    }

    match /invitations/{id} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.resource.data.createdBy == request.auth.uid;
    }

    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isAdmin();
    }

    match /adminAuditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
